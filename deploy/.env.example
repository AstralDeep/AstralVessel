# Copy to deploy/.env (ignored by git). Generate the secret with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Master secret. The executor, each sandbox and the egress get their own tokens derived from it by `astralvessel deploy`.
VESSEL_SANDBOX_TOKEN=
# Only when [egress] sets a model gateway.
VESSEL_UPSTREAM_MODEL_KEY=
