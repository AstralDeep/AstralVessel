# Copy to deploy/.env (ignored by git). Generate secrets with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
VESSEL_UPSTREAM_MODEL_URL=
VESSEL_UPSTREAM_MODEL_KEY=
# The example app's key, and its sha256: python3 -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" "$VESSEL_APP_KEY"
VESSEL_APP_KEY=
VESSEL_APP_KEY_SHA256=
# Master secret; each sandbox gets its own token derived from it by `astralvessel deploy`.
VESSEL_SANDBOX_TOKEN=
